{
  "policyVersion": 2,
  "allowedModules": ["access", "stations", "tenancy"],
  "dependencies": {
    "access": ["stations", "tenancy"],
    "stations": ["tenancy"],
    "tenancy": []
  },
  "publicSurfaces": {
    "access": ["AccessModuleContract"],
    "stations": ["StationsModuleContract"],
    "tenancy": ["TenancyModuleContract"]
  },
  "consumers": {
    "access": ["AppModule"],
    "stations": ["access"],
    "tenancy": ["access", "stations"]
  },
  "governedRoots": ["src/modules"],
  "nonStructuralFileNames": [".DS_Store", ".gitkeep"],
  "nonStructuralFileSuffixes": [".swp", ".tmp", "~"],
  "forbiddenGlobalRoots": ["base", "common", "core", "helpers", "utils"],
  "requiredStructuralFiles": {
    "src/app.module.ts": {
      "declarationKind": "class",
      "declarationName": "AppModule",
      "decorator": "Module",
      "rule": "D5-R023"
    },
    "src/modules/access/access.module.ts": {
      "declarationKind": "class",
      "declarationName": "AccessModule",
      "decorator": "Module",
      "rule": "D5-R003"
    },
    "src/modules/access/index.ts": {
      "declarationKind": "interface",
      "declarationName": "AccessModuleContract",
      "rule": "D5-R004"
    },
    "src/modules/stations/index.ts": {
      "declarationKind": "interface",
      "declarationName": "StationsModuleContract",
      "rule": "D5-R004"
    },
    "src/modules/stations/stations.module.ts": {
      "declarationKind": "class",
      "declarationName": "StationsModule",
      "decorator": "Module",
      "rule": "D5-R003"
    },
    "src/modules/tenancy/index.ts": {
      "declarationKind": "interface",
      "declarationName": "TenancyModuleContract",
      "rule": "D5-R004"
    },
    "src/modules/tenancy/tenancy.module.ts": {
      "declarationKind": "class",
      "declarationName": "TenancyModule",
      "decorator": "Module",
      "rule": "D5-R003"
    }
  },
  "appModuleComposition": {
    "file": "src/app.module.ts",
    "className": "AppModule",
    "decorator": "Module",
    "imports": {
      "AccessModule": "./modules/access/access.module.js",
      "StationsModule": "./modules/stations/stations.module.js",
      "TenancyModule": "./modules/tenancy/tenancy.module.js"
    }
  },
  "controllerAuthoritySymbols": [
    "authorize",
    "decideAuthorization",
    "resolveOperationalContext",
    "resolveTenantContext",
    "trustRequestContext"
  ],
  "persistence": {
    "dependencyPackages": ["kysely", "pg"],
    "dependencyPackagePrefixes": ["pg-"],
    "allowedDependencyRoots": [
      "src/infrastructure/database/",
      "src/modules/stations/infrastructure/persistence/",
      "src/modules/tenancy/infrastructure/persistence/"
    ],
    "databaseRoot": "src/infrastructure/database/",
    "migrationRoot": "src/infrastructure/database/migrations/",
    "migrationFilePattern": "^\\d{14}_(database|stations|tenancy)_[a-z][a-z0-9]*(?:_[a-z0-9]+)*\\.ts$",
    "infrastructureFiles": {
      "src/infrastructure/database/database-config.ts": {
        "owner": "database",
        "publicExports": [
          "DatabaseConfig",
          "DatabaseConfigError",
          "parseDatabaseConfig",
          "sanitizeDatabaseConfig"
        ],
        "consumers": ["src/infrastructure/database/database-connection.ts"],
        "status": "materialized-configuration"
      },
      "src/infrastructure/database/database-types.ts": {
        "owner": "database",
        "publicExports": ["DatabaseSchema"],
        "consumers": [
          "src/infrastructure/database/database-connection.ts",
          "src/infrastructure/database/migration-runner.ts",
          "src/modules/stations/infrastructure/persistence/kysely-branch.repository.ts",
          "src/modules/tenancy/infrastructure/persistence/kysely-tenant.repository.ts"
        ],
        "status": "future-approved"
      },
      "src/infrastructure/database/database-connection.ts": {
        "owner": "database",
        "publicExports": [
          "DatabaseConnection",
          "DatabaseConnectionError",
          "createDatabaseConnection",
          "sanitizeDatabaseConnectionState"
        ],
        "consumers": [
          "src/infrastructure/database/transaction-runner.ts",
          "src/infrastructure/database/migration-runner.ts",
          "src/modules/stations/stations.module.ts",
          "src/modules/tenancy/tenancy.module.ts"
        ],
        "status": "materialized-connection-facility"
      },
      "src/infrastructure/database/database-transaction-capability.ts": {
        "owner": "database",
        "publicExports": [
          "InternalDatabaseTransactionSettings",
          "InternalDatabaseTransactionExecutor",
          "InternalDatabaseTransactionOperation",
          "databaseTransactionCapability",
          "DatabaseTransactionCapabilityError",
          "InternalDatabaseTransactionConnection",
          "bindDatabaseTransactionContext",
          "releaseDatabaseTransactionContext",
          "useDatabaseTransactionExecutor"
        ],
        "consumers": [
          "src/infrastructure/database/database-connection.ts",
          "src/infrastructure/database/transaction-runner.ts"
        ],
        "status": "materialized-owner-internal-capability"
      },
      "src/infrastructure/database/transaction-runner.ts": {
        "owner": "database",
        "publicExports": [
          "DatabaseTransactionOptions",
          "DatabaseTransactionContext",
          "DatabaseTransactionError",
          "runInTransaction"
        ],
        "consumers": [
          "src/infrastructure/database/migration-runner.ts",
          "src/modules/stations/stations.module.ts",
          "src/modules/tenancy/tenancy.module.ts"
        ],
        "consumerRequirement": "deferred-until-migration-step",
        "status": "materialized-transaction-runner"
      },
      "src/infrastructure/database/migration-runner.ts": {
        "owner": "database",
        "publicExports": ["runMigrations"],
        "consumers": ["scripts/run-migrations.mjs"],
        "status": "future-approved"
      }
    },
    "ports": {
      "src/modules/stations/application/ports/branch-repository.port.ts": {
        "owner": "stations",
        "allowedScopes": ["TenantPersistenceScope", "TenantBranchPersistenceScope"],
        "status": "future-approved"
      },
      "src/modules/tenancy/application/ports/tenant-repository.port.ts": {
        "owner": "tenancy",
        "allowedScopes": ["TenantPersistenceScope"],
        "status": "future-approved"
      }
    },
    "scopeTypes": {
      "TenantBranchPersistenceScope": ["tenantId", "branchId"],
      "TenantPersistenceScope": ["tenantId"]
    },
    "adapters": {
      "src/modules/stations/infrastructure/persistence/kysely-branch.repository.ts": {
        "owner": "stations",
        "port": "src/modules/stations/application/ports/branch-repository.port.ts",
        "composition": "src/modules/stations/stations.module.ts",
        "status": "future-approved"
      },
      "src/modules/tenancy/infrastructure/persistence/kysely-tenant.repository.ts": {
        "owner": "tenancy",
        "port": "src/modules/tenancy/application/ports/tenant-repository.port.ts",
        "composition": "src/modules/tenancy/tenancy.module.ts",
        "status": "future-approved"
      }
    },
    "databaseObjects": {
      "branches": {
        "owner": "stations",
        "kind": "table"
      },
      "tenants": {
        "owner": "tenancy",
        "kind": "table"
      }
    },
    "databaseExecutorTypes": {
      "kysely": ["Kysely", "Transaction"],
      "pg": ["Client", "Pool", "PoolClient"]
    },
    "connectionProbe": {
      "file": "src/infrastructure/database/database-connection.ts",
      "function": "runConnectionVerification",
      "sql": "select 1"
    },
    "driverPublicTypes": {
      "kysely": ["Kysely", "RawBuilder", "Transaction"],
      "pg": ["Client", "Pool", "PoolClient", "QueryArrayResult", "QueryResult", "QueryResultRow"]
    },
    "forbiddenGlobalSurfaceNames": [
      "client",
      "database",
      "db",
      "executeQuery",
      "kysely",
      "pool",
      "query"
    ],
    "genericRepositoryCapabilities": [
      "create",
      "delete",
      "find",
      "findAll",
      "findById",
      "insert",
      "remove",
      "save",
      "update"
    ],
    "startupFiles": ["src/main.ts", "src/app.module.ts"],
    "transactionBoundary": {
      "runner": "src/infrastructure/database/transaction-runner.ts",
      "capability": "src/infrastructure/database/database-transaction-capability.ts",
      "allowedCapabilityConsumers": [
        "src/infrastructure/database/database-connection.ts",
        "src/infrastructure/database/transaction-runner.ts"
      ],
      "forbiddenContextPackages": ["async_hooks", "node:async_hooks"],
      "forbiddenManualMethods": [
        "commit",
        "releaseSavepoint",
        "rollback",
        "rollbackToSavepoint",
        "savepoint",
        "startTransaction"
      ]
    },
    "status": "transaction-runner-materialized"
  },
  "checkerRules": [
    "D5-R002",
    "D5-R003",
