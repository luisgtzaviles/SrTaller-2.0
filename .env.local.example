# SR Taller 2.0 — Local Development only
# `pnpm run local:config` creates .env.local with generated credentials.
# Do not copy Preview/Dokploy values here. Do not add DATABASE_URL or PG*.
SR_LOCAL_ENVIRONMENT=local
SR_LOCAL_DB_HOST=127.0.0.1
SR_LOCAL_DB_PORT=55432
SR_LOCAL_DB_NAME=srtaller_local
SR_LOCAL_ADMIN_USER=srtaller_local_admin
SR_LOCAL_ADMIN_PASSWORD=generated-by-local-config
SR_LOCAL_MIGRATION_USER=srtaller_local_migration
SR_LOCAL_MIGRATION_PASSWORD=generated-by-local-config
SR_LOCAL_APPLICATION_USER=srtaller_local_application
SR_LOCAL_APPLICATION_PASSWORD=generated-by-local-config
SR_LOCAL_BACKEND_HOST=127.0.0.1
SR_LOCAL_BACKEND_PORT=3000
SR_LOCAL_VITE_HOST=127.0.0.1
SR_LOCAL_VITE_PORT=4173
SR_STATION_BOOTSTRAP_SECRET=generated-by-local-config
SR_USER_BOOTSTRAP_SECRET=generated-by-local-config
SR_PIN_PEPPER=generated-by-local-config
# The Owner PIN remains only in ignored local configuration so a fresh local
# database volume can recreate the same test identity. Never copy it to Preview.
SR_LOCAL_PIN_LUIS=choose-stable-local-only-pin
# Other demo PINs are supplied only to the seed process as SR_LOCAL_PIN_* variables.
