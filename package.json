{
  "name": "srtaller-2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Governed technical shell with the recovered Visual Slice 0 preview UI.",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.15.1"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "preinstall": "node ./scripts/verify-install-context.mjs",
    "verify:toolchain": "node ./scripts/verify-toolchain.mjs",
    "verify:integration-baseline": "pnpm run verify:toolchain && node ./scripts/verify-integration-baseline.mjs",
    "verify:runtime-provenance": "pnpm run verify:toolchain && node ./scripts/verify-runtime-provenance.mjs",
    "verify:change-risk": "pnpm run verify:toolchain && node ./scripts/classify-workflow-change.mjs",
    "verify:docs-only": "pnpm run verify:toolchain && node ./scripts/verify-docs-only.mjs",
    "preflight:development": "pnpm run verify:toolchain && node ./scripts/development-preflight.mjs",
    "work-unit:check": "pnpm run verify:toolchain && node ./scripts/check-work-unit.mjs",
    "work-unit:start": "pnpm run verify:toolchain && node ./scripts/start-work-unit.mjs",
    "work-unit:risk:shadow": "pnpm run verify:toolchain && node ./scripts/compare-work-unit-risk.mjs",
    "verify:preview-migrations": "pnpm run verify:toolchain && node ./scripts/verify-preview-migration-state.mjs",
    "attest:tree:shadow": "pnpm run verify:toolchain && node ./scripts/create-verified-tree-attestation.mjs",
    "verify:repair-detail-parity": "pnpm run verify:toolchain && node ./scripts/verify-repair-detail-parity.mjs",
    "verify:structure": "node ./scripts/verify-structure.mjs",
    "verify:architecture": "pnpm run verify:toolchain && node ./scripts/check-architecture.mjs --root .",
    "verify:ui": "pnpm run verify:toolchain && node ./scripts/check-ui-foundation.mjs",
    "verify:ui:production": "pnpm run verify:toolchain && node ./scripts/verify-ui-production-build.mjs",
    "verify:external-configuration": "pnpm run verify:toolchain && node ./scripts/check-external-configuration.mjs",
    "verify:container": "pnpm run verify:toolchain && node ./scripts/verify-oci-image.mjs",
    "architecture": "pnpm run verify:architecture",
    "test:architecture": "pnpm run verify:toolchain && node --test test/architecture-*.test.mjs",
    "clean": "node ./scripts/clean.mjs",
    "typecheck": "pnpm run verify:toolchain && tsc -p tsconfig.json --noEmit && pnpm --filter @srtaller/dev-preview-web typecheck",
    "build": "pnpm run verify:toolchain && pnpm run clean && tsc -p tsconfig.build.json && pnpm --filter @srtaller/dev-preview-web build",
    "db:migrate": "pnpm run verify:toolchain && node --enable-source-maps dist/db-migrate.js",
    "local:config": "pnpm run verify:toolchain && node ./scripts/local-config.mjs",
    "local:db:up": "pnpm run verify:toolchain && node ./scripts/local-db.mjs up",
    "local:db:down": "pnpm run verify:toolchain && node ./scripts/local-db.mjs down",
    "local:db:migrate": "pnpm run verify:toolchain && node ./scripts/local-db-migrate.mjs",
    "local:db:seed": "pnpm run verify:toolchain && node ./scripts/local-db-seed.mjs",
    "local:cleanup:synthetic-supplier": "pnpm run verify:toolchain && node ./scripts/cleanup-local-synthetic-supplier.mjs",
    "local:admin:provision": "pnpm run build && node ./scripts/provision-local-admin.mjs",
    "users:provision-first": "pnpm run build && node ./scripts/provision-first-user.mjs",
    "local:db:reset": "pnpm run verify:toolchain && node ./scripts/local-reset.mjs",
    "local:backend": "pnpm run verify:toolchain && node ./scripts/local-backend.mjs",
    "local:dev": "pnpm run verify:toolchain && node ./scripts/local-dev.mjs",
    "test": "pnpm run verify:toolchain && node --test test/*.test.mjs",
    "test:preview-db": "pnpm run verify:toolchain && node ./scripts/test-preview-database-runtime-postgresql.mjs",
    "test:pbi039:postgresql": "pnpm run verify:toolchain && node ./scripts/test-pbi039-postgresql.mjs",
    "test:pbi040:postgresql": "pnpm run verify:toolchain && node ./scripts/test-pbi040-postgresql.mjs",
    "test:pbi041:postgresql": "pnpm run verify:toolchain && node ./scripts/test-pbi041-postgresql.mjs",
    "test:tl02:postgresql": "pnpm run verify:toolchain && node ./scripts/test-tl02-postgresql.mjs",
    "start": "pnpm run verify:toolchain && node --enable-source-maps dist/main.js",
    "smoke:start": "pnpm run verify:toolchain && node ./scripts/smoke-start.mjs",
    "smoke:ui": "pnpm run verify:toolchain && node ./scripts/smoke-ui.mjs",
    "verify:pbi043:chrome": "pnpm run verify:toolchain && node ./scripts/verify-pbi043-chrome.mjs",
    "diagnose:local": "pnpm run verify:toolchain && node ./scripts/local-diagnostics.mjs",
    "dev": "pnpm run verify:toolchain && node ./scripts/dev.mjs",
    "verify": "pnpm run verify:toolchain && pnpm run clean && pnpm run typecheck && pnpm run build && pnpm run test && pnpm run verify:structure && pnpm run verify:architecture && pnpm run verify:external-configuration && pnpm run verify:ui && pnpm run verify:ui:production",
    "verify:full": "pnpm run verify:toolchain && node ./scripts/verify-full.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "kysely": "0.29.4",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "typescript": "6.0.3"
  }
}
