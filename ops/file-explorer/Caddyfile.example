files.srtaller.dev {
    encode zstd gzip

    request_body {
        max_size 2MB
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        X-Robots-Tag "noindex, nofollow, noarchive"
    }

    basic_auth {
        {env.SR_FILES_BASIC_AUTH_USER} {env.SR_FILES_BASIC_AUTH_HASH}
    }

    reverse_proxy 127.0.0.1:3200

    log {
        output stdout
        format json
    }
}

