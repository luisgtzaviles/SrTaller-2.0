preview.example.invalid {
	encode zstd gzip

	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	# Configure both values in Caddy's root-owned systemd environment.
	# Generate the hash on the host with: caddy hash-password
	basic_auth {
		{env.SR_PREVIEW_BASIC_AUTH_USER} {env.SR_PREVIEW_BASIC_AUTH_HASH}
	}

	reverse_proxy 127.0.0.1:3100

	log {
		output file /opt/srtaller-preview/shared/logs/caddy-access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
