# Copy to /opt/srtaller-preview/shared/.env, set owner root:srtaller-preview,
# permissions 0640, and replace every placeholder outside Git.
NODE_ENV=production
HOST=127.0.0.1
PORT=3100

SR_PREVIEW_ENABLED=true
SR_PREVIEW_TENANT_ID=10000000-0000-4000-8000-000000000001
SR_PREVIEW_BRANCH_ID=30000000-0000-4000-8000-000000000001
SR_PREVIEW_STATION_ID=50000000-0000-4000-8000-000000000001
SR_PREVIEW_STATION_EVIDENCE=replace-with-private-opaque-development-evidence
SR_PREVIEW_TENANT_NAME="Tenant Demo SR"
SR_PREVIEW_BRANCH_NAME="Sucursal Centro Demo"
SR_PREVIEW_STATION_LABEL="Estación Recepción 01"
SR_PREVIEW_ACTOR_LABEL="Operador DEV_ONLY"
SR_PREVIEW_PUBLIC_BASE_URL=https://preview.example.invalid/

SR_DB_ENVIRONMENT=development
SR_DB_HOST=127.0.0.1
SR_DB_PORT=5432
SR_DB_NAME=srtaller_preview
SR_DB_USER=srtaller_preview_application
SR_DB_PASSWORD=replace-with-private-development-password
SR_DB_SSL_MODE=disable
SR_DB_POOL_MIN=0
SR_DB_POOL_MAX=8
SR_DB_IDLE_TIMEOUT_MS=30000
SR_DB_CONNECTION_TIMEOUT_MS=5000
SR_DB_STATEMENT_TIMEOUT_MS=15000
SR_DB_QUERY_TIMEOUT_MS=20000
SR_DB_APPLICATION_NAME=srtaller-preview
SR_DB_ROLE=application
SR_DB_ACCESS_MODE=read-write
SR_DB_MIGRATIONS_ENABLED=false
